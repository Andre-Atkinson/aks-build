# Copy to .env and fill in. .env is gitignored - nothing here should ever be
# committed. orchestrator/*.py load this automatically (python-dotenv).
#
# This is the only place secrets/config for this demo live - there's no
# other secrets store wired up (no Key Vault / Secrets Manager), because the
# whole point is a short-lived cluster you spin up, demo, and destroy.

# Required for create.py / destroy.py
AZURE_SUBSCRIPTION_ID=
AWS_REGION=ap-southeast-2

# Required for create.py - registry path for the built veeamon-tour image
# (docker build/push this yourself first, see README)
VEEAMON_IMAGE=

# Optional - puts a LoadBalancer Service (gateway-ext) in front of each K10
# dashboard instead of requiring kubectl port-forward. ~$0.05/hr combined
# (Azure Standard LB + AWS Classic LB). Defaults to false (port-forward is
# more secure for a cluster nobody else needs to reach) - set true if you're
# doing a live walkthrough across both dashboards.
EXPOSE_K10_DASHBOARD=

# Optional overrides for the MariaDB passwords. Leave unset and
# templates/mariadb-secret.yaml auto-generates random passwords, stored
# only in the in-cluster <release>-mariadb Secret - never written to disk here.
MARIADB_ROOT_PASSWORD=
MARIADB_APP_PASSWORD=

# Only needed if you apply infra/cloudflare
CLOUDFLARE_API_TOKEN=
TF_VAR_account_id=
TF_VAR_zone_id=
TF_VAR_hostname=
